# Copie para .env (chmod 600) e preencha com valores reais. Nunca commite o .env real.

# Bucket S3 usado como repositório do restic. Formato: s3:s3.<regiao>.amazonaws.com/<nome-do-bucket>
RESTIC_REPOSITORY=s3:s3.sa-east-1.amazonaws.com/seu-bucket

# Senha de criptografia do repositório restic. Gere uma vez com: openssl rand -base64 32
# Guarde isso em algum lugar fora da VPS também (gerenciador de senhas) - perder essa senha significa perder os backups.
RESTIC_PASSWORD=troque-isso

# Credenciais do usuário IAM restrito ao bucket acima (ver docs/backup.md para a policy IAM)
AWS_ACCESS_KEY_ID=troque-isso
AWS_SECRET_ACCESS_KEY=troque-isso
