# Copie para .env e preencha com valores reais. Nunca commite o .env real.
# Passado via env_file (não interpolação do YAML), então caracteres especiais em senhas são seguros.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=troque-isso

# Camada de basic auth na frente do Grafana (Caddy), separada do login próprio do Grafana.
GRAFANA_PROXY_USER=troque-isso
# Gere com: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
GRAFANA_PROXY_PASS_HASH=troque-isso

# String de conexão do postgres_exporter para a instância Postgres do recompra-farma
DATA_SOURCE_NAME=postgresql://USUARIO:SENHA@farma-postgres:5432/NOME_DO_BANCO?sslmode=disable
